@model System.Text.Json.Nodes.JsonArray
@{
    ViewData["Title"] = "Upcoming Events";
}

<h2 class="mt-4">Upcoming Events</h2>

<!-- Show success or error messages -->
@if (TempData["Msg"] != null)
{
    <div class="alert alert-success">@TempData["Msg"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row mt-3">
    @if (Model != null)
    {
        foreach (var ev in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100 border-0" style="transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                    <img src="@(ev["imageUrl"]?.ToString() ?? "https://via.placeholder.com/600x300")" class="card-img-top" style="height:200px; object-fit:cover;" alt="Event">
                    <div class="card-body">
                        <h5 class="card-title">@ev["eventName"]</h5>
                        <p class="card-text text-muted">@ev["location"] | @ev["distance"]km</p>
                        <p class="card-text">@ev["description"]</p>

                        <!-- ENROL FORM -->
                        <form asp-action="Enrol" method="post" class="mt-3">
                            <input type="hidden" name="categoryId" value="1" />
                            <button type="submit" class="btn btn-primary w-100">Enrol in Event</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>