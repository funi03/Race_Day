@model System.Text.Json.Nodes.JsonArray
@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="d-flex justify-content-between align-items-center mt-4">
    <h2>Enrolments for Event</h2>
    <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success">@TempData["Msg"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Participant Name</th>
            <th>Status</th>
            <th>Capture Result</th> <!-- NEW COLUMN -->
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var enrol in Model)
            {
                <tr>
                    <td>@enrol["participant"]?["user"]?["fullName"]</td>
                    <td><span class="badge bg-success">@enrol["status"]</span></td>

                    <!-- FORM TO CAPTURE RESULT -->
                    <td>
                        <form asp-action="AddResult" method="post" class="d-flex gap-2">
                            <input type="hidden" name="enrolmentId" value="@enrol["enrolmentID"]" />
                            <input type="hidden" name="eventId" value="@ViewBag.EventId" />

                            <input type="number" name="finishPosition" placeholder="Position" class="form-control form-control-sm" style="width: 100px;" required />
                            <input type="text" name="finishTime" placeholder="00:30:00" class="form-control form-control-sm" style="width: 120px;" required />

                            <button type="submit" class="btn btn-sm btn-success">Save</button>
                        </form>
                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">No enrolments yet.</td>
            </tr>
        }
    </tbody>
</table>